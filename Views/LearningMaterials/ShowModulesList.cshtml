@using Quantify.ViewModels
@model List<ShowModuleContentViewModel>

@{
    ViewData["Title"] = "Show Modules Lists";
}

<div class="text-center mt-4"><h1>Dostępne rozdziały:</h1></div>
<div class="text-start mt-3">
    @foreach(var module in Model){
        <div class="card mb-3">
            <div class="card-body">
                <a class="stretched-link text-decoration-none" asp-controller="LearningMaterials" asp-action="ShowModuleContent" asp-route-moduleId="@module.ModuleId">
                    <h5 class="card-title">@module.Name</h5>
                </a>
                 @if(module.Description != null){
                <p class="card-text">@module.Description</p>
                }
            </div>
        </div>
    }
</div>
@if(User.Identity?.IsAuthenticated == true && User.IsInRole("Admin")){
    <a class="btn btn-primary" asp-controller="Modules" asp-action="AddModule">Add a new Module</a>
}
