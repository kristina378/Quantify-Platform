@using Quantify.ViewModels
@model ShowTopicContentViewModel

@{
    ViewData["Title"] = "Show Topic Content";
}

<div class="text-start mt-4"><h1>@Model.Name:</h1></div>
<div class="text-start mt-3">@Html.Raw(Model.Content)</div>
<div class="text-center mt-3"><h2>Dostępne zadania:</h2></div>
<div class="text-start mt-3">
    @if(Model.Tasks != null){
        long nr = 1;
        foreach(ShowTaskContentViewModel task in Model.Tasks){
            <div class="text-start">
                <a asp-controller="LearningMaterials" asp-action="ShowTaskContent" asp-route-taskId="@task.TaskId">Zadanie @nr</a>
            </div>
            nr++;
        }
    }
</div>
@if(User.Identity?.IsAuthenticated == true && User.IsInRole("Admin")){
    <div class="text-center mt-3">
        <a class="btn btn-primary" asp-controller="Modules" asp-action="AddTask" asp-route-moduleId="@Model.ModuleId" asp-route-topicId="@Model.TopicId">Add new task</a>
    </div>
}

