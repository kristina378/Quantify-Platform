@using Quantify.Core.Users
@{
    string userRole;
    string action = string.Empty;
    if(User.Identity?.IsAuthenticated == true){

        if(User.IsInRole("Tutor")){
            userRole = "Tutor";
            action = "EditTutor";
        }
        else if(User.IsInRole("Student")){
            userRole = "Student";
            action = "EditStudent";
        }
        else{
            userRole = "Developer";
            action = "EditAdmin";
        }
    }
    else{
        userRole = "Guest";
    }

}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quantify</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.18.1/dist/katex.min.css" integrity="sha384-1vdNCNel6Tx/NQa8IR1mGOGKsbGreCkOPfbtPPnUURJ5Tu2PRVfQ/7KLZC+Pi1p1" crossorigin="anonymous">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="/">Quantify @userRole</a>
                <div class="collapse navbar-collapse d-flex justify-content-start">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="LearningMaterials" asp-action="ShowModulesList" style="color: #77b6ff">
                                Materiały
                            </a>
                        </li>
                    </ul>
                </div>
                @if(User.Identity?.IsAuthenticated == false){
                    <div class="collapse navbar-collapse d-flex justify-content-end">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Login">Zaloguj</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Register">Zarejestruj</a>
                            </li>
                        </ul>
                    </div>
                }
               else{
                        <div class="collapse navbar-collapse d-flex justify-content-end">
                            <ul class="navbar-nav">
                                @* <li class="nav-item d-flex align-items-center">
                                    <span class="navbar-text me-3">Cześć @User.Identity?.Name!</span>
                                </li> *@
                                
                                @if (User.IsInRole("Student"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="" asp-controller="Statistics" asp-action="DisplayStudentStatistics">My Stats</a>
                                    </li>
                                }
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Profile" asp-action="@action">Mój profil</a>
                                </li>
                                <li>
                                    <form method="post" asp-controller="Account" asp-action="Logout">
                                        <button type="submit" class="btn btn-outline-danger btn-sm ms-2">Wyloguj</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                }
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center mt-5 py-3">
        <div class="container">
            &copy; 2026 - Quantify
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.18.1/dist/katex.min.js" integrity="sha384-ycJ6GAwiS15LoUPipwJOrWTvkUHl/YqELValBwI5I4awP1EeEQJYarj+w85ntcz7" crossorigin="anonymous"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.18.1/dist/contrib/auto-render.min.js" integrity="sha384-bjyGPfbij8/NDKJhSGZNP/khQVgtHUE5exjm4Ydllo42FwIgYsdLO2lXGmRBf5Mz" crossorigin="anonymous"
    onload="renderMathInElement(document.body);"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>